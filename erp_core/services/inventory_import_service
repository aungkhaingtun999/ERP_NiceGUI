# ==============================================================================
# erp_core/services/inventory_import_service.py
#
# ERP ENTERPRISE INVENTORY IMPORT SERVICE v1.0
#
# Purpose:
#   - Inventory In / Stock Import
#   - Maker-Checker workflow
#   - Batch creation
#   - Batch line insertion
#   - Submit / validation
#   - Approval queue
#   - RPC bridge
#
# Database RPCs already verified:
#   submit_inventory_import_batch
#   approve_inventory_import_batch
#
# ==============================================================================

from __future__ import annotations

from typing import Any, Dict, List, Optional


class InventoryImportService:
    """
    Service layer for Inventory In / Stock Import.

    This service does NOT directly post stock.

    Stock posting must happen through the approved
    Maker-Checker database RPC workflow.
    """

    def __init__(self, client):
        self.client = client

    # ==========================================================================
    # INTERNAL
    # ==========================================================================

    def _table(self, table_name: str):
        return self.client.table(table_name)

    @staticmethod
    def _unwrap_response(response):
        if response is None:
            return None

        if hasattr(response, "data"):
            return response.data

        return response

    # ==========================================================================
    # CREATE BATCH
    # ==========================================================================

    def create_batch(
        self,
        batch_no: str,
        transaction_type: str,
        warehouse_to: int,
        requested_by: Optional[str] = None,
        remarks: Optional[str] = None,
    ) -> Dict[str, Any]:

        payload = {
            "batch_no": batch_no,
            "transaction_type": transaction_type,
            "status": "DRAFT",
            "warehouse_to": warehouse_to,
            "requested_by": requested_by,
            "remarks": remarks,
            "total_lines": 0,
            "valid_lines": 0,
            "error_lines": 0,
        }

        response = (
            self._table("inventory_import_batches")
            .insert(payload)
            .execute()
        )

        data = self._unwrap_response(response)

        if not data:
            raise RuntimeError("Failed to create inventory import batch.")

        return data[0] if isinstance(data, list) else data

    # ==========================================================================
    # GET BATCH
    # ==========================================================================

    def get_batch(self, batch_id: int):
        response = (
            self._table("inventory_import_batches")
            .select("*")
            .eq("id", batch_id)
            .maybe_single()
            .execute()
        )

        return self._unwrap_response(response)

    # ==========================================================================
    # GET BATCH BY NUMBER
    # ==========================================================================

    def get_batch_by_no(self, batch_no: str):
        response = (
            self._table("inventory_import_batches")
            .select("*")
            .eq("batch_no", batch_no)
            .maybe_single()
            .execute()
        )

        return self._unwrap_response(response)

    # ==========================================================================
    # ADD LINE
    # ==========================================================================

    def add_line(
        self,
        batch_id: int,
        line_no: int,
        warehouse_id: int,
        sku: str,
        qty,
        unit_cost=None,
        lot_no=None,
        product_id=None,
        mfg_date=None,
        expiry_date=None,
        reference_no=None,
        supplier_code=None,
    ) -> Dict[str, Any]:

        payload = {
            "batch_id": batch_id,
            "line_no": line_no,
            "warehouse_id": warehouse_id,
            "sku": sku,
            "product_id": product_id,
            "qty": qty,
            "unit_cost": unit_cost,
            "lot_no": lot_no,
            "mfg_date": mfg_date,
            "expiry_date": expiry_date,
            "reference_no": reference_no,
            "supplier_code": supplier_code,
            "is_valid": False,
            "error_message": None,
        }

        response = (
            self._table("inventory_import_lines")
            .insert(payload)
            .execute()
        )

        data = self._unwrap_response(response)

        if not data:
            raise RuntimeError("Failed to create inventory import line.")

        return data[0] if isinstance(data, list) else data

    # ==========================================================================
    # GET LINES
    # ==========================================================================

    def get_lines(self, batch_id: int) -> List[Dict[str, Any]]:
        response = (
            self._table("inventory_import_lines")
            .select("*")
            .eq("batch_id", batch_id)
            .order("line_no")
            .execute()
        )

        data = self._unwrap_response(response)

        return data or []

    # ==========================================================================
    # DELETE DRAFT LINE
    # ==========================================================================

    def delete_line(self, line_id: int):
        response = (
            self._table("inventory_import_lines")
            .delete()
            .eq("id", line_id)
            .execute()
        )

        return self._unwrap_response(response)

    # ==========================================================================
    # SUBMIT
    # ==========================================================================

    def submit_batch(self, batch_no: str) -> Dict[str, Any]:

        response = self.client.rpc(
            "submit_inventory_import_batch",
            {
                "p_batch_no": batch_no,
            },
        ).execute()

        data = self._unwrap_response(response)

        if isinstance(data, dict):
            return data

        return {
            "success": False,
            "message": "Unexpected submit RPC response.",
            "data": data,
        }

    # ==========================================================================
    # APPROVE
    # ==========================================================================

    def approve_batch(
        self,
        batch_id: int,
        checker_id: str,
    ) -> Dict[str, Any]:

        response = self.client.rpc(
            "approve_inventory_import_batch",
            {
                "p_batch_id": batch_id,
                "p_checker_id": checker_id,
            },
        ).execute()

        data = self._unwrap_response(response)

        if isinstance(data, dict):
            return data

        return {
            "success": False,
            "message": "Unexpected approval RPC response.",
            "data": data,
        }

    # ==========================================================================
    # PENDING QUEUE
    # ==========================================================================

    def get_pending_batches(self) -> List[Dict[str, Any]]:

        response = (
            self._table("inventory_import_batches")
            .select("*")
            .eq("status", "PENDING")
            .order("created_at", desc=False)
            .execute()
        )

        data = self._unwrap_response(response)

        return data or []

    # ==========================================================================
    # ALL BATCHES
    # ==========================================================================

    def get_batches(self, limit: int = 100):

        response = (
            self._table("inventory_import_batches")
            .select("*")
            .order("created_at", desc=True)
            .limit(limit)
            .execute()
        )

        data = self._unwrap_response(response)

        return data or []
